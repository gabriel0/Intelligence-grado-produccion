# Valores por defecto. Copiá a `.env` y completá PINECONE_API_KEY.
# En Docker Compose, las URLs internas de Redis/Phoenix se sobrescriben en docker-compose.yml.

# ollama | gemini
LLM_PROVIDER=ollama

# ollama | google  (si no se setea: google cuando LLM=gemini, si no ollama)
# Con google no hace falta Ollama en el host.
EMBEDDING_PROVIDER=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_KEEP_ALIVE=2m

# Chat Gemini + (por defecto) embeddings Google
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_EMBED_MODEL=gemini-embedding-001
GOOGLE_EMBED_DIMS=1536

# Pinecone (obligatorio)
PINECONE_API_KEY=
# Con embeddings google conviene un índice aparte (1536 dims), p.ej. intelligence-system-gemini
INDEX_NAME=intelligence-system
PINECONE_NAMESPACE=intelligence-system
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
MAX_UPLOAD_BYTES=2097152

REDIS_URL=redis://localhost:6379
PHOENIX_URL=http://127.0.0.1:6006
PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT=intelligence-system
API_HOST=127.0.0.1
API_PORT=8000
MAX_PASOS=4
MAX_VISITAS=2
TOP_K=4
PROMPT_VERSION=intelligence-system-v1
JOB_TIMEOUT=600
COSTO_ENTRADA_POR_MILLON=2
COSTO_SALIDA_POR_MILLON=8
